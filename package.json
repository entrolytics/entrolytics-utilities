{
  "name": "@entrolytics/utilities",
  "version": "3.0.1",
  "description": "Common utilities and helper functions for Entrolytics",
  "keywords": [
    "entrolytics",
    "helpers",
    "utilities",
    "utils"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/utilities/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/utilities",
    "directory": "packages/utilities/entrolytics-utilities"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "typescript": "next",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@11.28.10"
}
